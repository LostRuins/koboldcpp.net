---
/* The hero: the site nav, one sentence on what KoboldCpp is, the two ways in, and two real screenshots
   of KoboldAI Lite. Side by side on wide screens; below that the navy background stops partway down the
   screenshots (home.css .hero::before). */
import { Image } from 'astro:assets';
import HomeHeader from './HomeHeader.astro';
import liteVision from '../../assets/home/lite-vision.png';
import liteAesthetic from '../../assets/home/lite-aesthetic.png';
import { LATEST_URL } from '../../data/release';
import { ROUTES } from '../../data/routes';
---

<header class="hero">
	<HomeHeader />
	<div class="wrap hero-body">
		<div class="hero-copy">
			<h1>Run AI models locally with KoboldCpp</h1>
			<p class="hero-lead">
				KoboldCpp runs AI models on your own computer. Write stories, roleplay chat, generate music, and make images for free. One file, no install.
			</p>
			<div class="hero-actions">
				<a class="btn btn-light" href={ROUTES.download}>Download</a>
				<a class="btn btn-outline" href={ROUTES.gettingStarted}>Getting started</a>
			</div>
			<p class="hero-meta">
				Free and open source · Works offline · Official downloads on <a href={LATEST_URL}>GitHub</a>
			</p>
		</div>
		<figure class="showcase">
			<div class="shots">
				<div class="browser">
					<div class="browser-bar" aria-hidden="true">
						<span class="dots"><i></i><i></i><i></i></span><span class="url">localhost:5001</span>
					</div>
					<Image
						src={liteVision}
						widths={[800, 1600]}
						sizes="(min-width: 64rem) 33rem, min(58vw, 28rem)"
						priority
						alt="KoboldAI Lite in the Corpo theme: comparing two images with vision."
					/>
				</div>
				<Image class="shot-second" src={liteAesthetic} widths={[400, 800]} sizes="(min-width: 64rem) 14rem, 36vw" alt="KoboldAI Lite in the Aesthetic theme: a roleplay chat." />
			</div>
			<figcaption>KoboldCpp runs on Windows, Linux and macOS. KoboldAI Lite WebUI runs on any browser.</figcaption>
		</figure>
	</div>
</header>

<script>
	// Progressive enhancement only: the nav turns into the docs' solid bar once the hero has scrolled away.
	const header = document.querySelector<HTMLElement>('[data-kc-header]');
	const heroCopy = document.querySelector('.hero-copy');
	if (header && heroCopy) {
		new IntersectionObserver(([entry]) => {
			if (entry) header.toggleAttribute('data-stuck', !entry.isIntersecting && entry.boundingClientRect.top < 0);
		}).observe(heroCopy);
	}
</script>
