---
/* One row of site links, then who makes KoboldCpp and where the official downloads are. Every other
   external link is on the Links page. */
import { Image } from 'astro:assets';
import logo from '../../assets/kobold-favicon.png';
import { LATEST_URL } from '../../data/release';
import { ROUTES, EXT } from '../../data/routes';
---

<footer class="footer on-dark">
	<div class="wrap footer-row">
		<a class="brand" href={ROUTES.home}>
			<span class="brand-mark"><Image src={logo} width={32} height={32} densities={[1, 2, 3]} alt="" /></span>
			KoboldCpp
		</a>
		<nav aria-label="Footer">
			<ul>
				<li><a href={ROUTES.download}>Download</a></li>
				<li><a href={ROUTES.gettingStarted}>Getting started</a></li>
				<li><a href={ROUTES.docs}>Wiki</a></li>
				<li><a href={ROUTES.links}>Links</a></li>
				<li><a href={EXT.repo}>KoboldCpp Github</a></li>
			</ul>
		</nav>
	</div>
	<div class="wrap footer-base">
		<p>
			KoboldCpp is free and open source (<span class="nw">AGPL-3.0</span>). Official
			downloads are on the <a href={LATEST_URL}>KoboldCpp GitHub Releases</a> page. <a href="/docs/install/staying-safe/">Beware of other fake sites</a>.
		</p>
	</div>
</footer>
