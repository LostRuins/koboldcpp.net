---
/* Home page: hero with screenshots → three steps → what you can do → footer. Kept short on purpose:
   the beginner guide and the wiki hold the details. Not a Starlight page. */
import HomeLayout from '../layouts/HomeLayout.astro';
import IconSprite from '../components/home/IconSprite.astro';
import Hero from '../components/home/Hero.astro';
import Steps from '../components/home/Steps.astro';
import Features from '../components/home/Features.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
// Side effect: fails the build if a docs download link names a file the latest release doesn't have.
import '../data/download-check';
---

<HomeLayout
	title="KoboldCpp official site: run AI models locally"
	description="Free, open-source software for running GGUF AI models on Windows, Linux and macOS. One file, no install. Official downloads, guides and docs."
	ogTitle="KoboldCpp: run AI models on your own computer"
	ogDescription="One free download for writing, chat, images, voice and music. No install, no account. Official downloads from GitHub."
>
	<IconSprite />
	<Hero />
	<main id="main">
		<Steps />
		<Features />
	</main>
	<SiteFooter />
</HomeLayout>
